%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% CS_report.sty
%% Dissertation formatting style
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%-------------------------------------
%% Page layout
%%-------------------------------------
\usepackage[
    a4paper,
    left=30mm,
    right=20mm,
    top=30mm,
    bottom=22mm,
    textwidth=160mm,
    textheight=245mm,
    footskip=10mm
]{geometry}

%%-------------------------------------
%% Font and encoding
%%-------------------------------------
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage{amsmath}
\usepackage{amssymb}
\let\Bbbk\relax
\let\openbox\relax
\usepackage{newtxtext,newtxmath} % Times-like text and math
\let\openbox\relax

%%-------------------------------------
%% Line spacing
%%-------------------------------------
\usepackage{setspace}
\onehalfspacing

%%-------------------------------------
%% Paragraph formatting
%%-------------------------------------
\setlength{\parindent}{12mm}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{3em}

%% Avoid widows and orphans
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000

%%-------------------------------------
%% Mathematics and theorem support
%%-------------------------------------
\usepackage{amsthm}

\newtheorem{mydef}{Definition}
\newtheorem{mytherm}{Theorem}

%%-------------------------------------
%% Graphics and floats
%%-------------------------------------
\usepackage{graphicx}
\usepackage{float}
\usepackage{subfig}
\usepackage{caption}
\usepackage{multirow}
\usepackage{rotating}
\usepackage{makecell}
\usepackage{booktabs}
\usepackage{array}

%% Figure and table numbering chapter-wise
\numberwithin{figure}{chapter}
\numberwithin{table}{chapter}

%% Captions
\captionsetup[figure]{font=small,labelfont=bf,labelsep=colon}
\captionsetup[table]{font=small,labelfont=bf,labelsep=colon}

%%-------------------------------------
%% Algorithms and listings
%%-------------------------------------
\usepackage{algorithm}
\usepackage{algpseudocode}

\renewcommand{\algorithmicrequire}{\textbf{Input:}}
\renewcommand{\algorithmicensure}{\textbf{Output:}}

\usepackage{listings}
\usepackage{xcolor}

\definecolor{codegreen}{rgb}{0,0.6,0.1}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codeblue}{rgb}{0.10,0.00,1.00}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{1.0,1.0,1.0}

\lstdefinestyle{mystyle}{
    backgroundcolor=\color{backcolour},
    commentstyle=\color{codegreen},
    keywordstyle=\color{codeblue},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\footnotesize,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=2,
    frame=none
}
\lstset{style=mystyle}

%%-------------------------------------
%% Lists
%%-------------------------------------
\usepackage{enumitem}
\setlist[itemize]{topsep=4pt,itemsep=4pt,parsep=0pt,partopsep=0pt}
\setlist[enumerate]{topsep=4pt,itemsep=4pt,parsep=0pt,partopsep=0pt}

\newlist{abbrv}{itemize}{1}
\setlist[abbrv,1]{label=,labelwidth=1in,align=parleft,itemsep=0.1\baselineskip,leftmargin=!}

%%-------------------------------------
%% Chapter / section formatting
%%-------------------------------------
%%-------------------------------------
%% Chapter / section formatting
%%-------------------------------------
\usepackage{titlesec}

\titleformat{\chapter}[display]
  {\bfseries\raggedright}
  {\fontsize{19}{21}\selectfont Chapter \thechapter}
  {2mm}
  {\fontsize{24}{28}\selectfont}
  [\vspace{1mm}\rule{1\textwidth}{0.4pt}]

\titlespacing*{\chapter}{0pt}{24mm}{0mm}

\titleformat{\section}
  {\bfseries\fontsize{16}{18}\selectfont}
  {\thesection}{1em}{}
\titlespacing*{\section}{0pt}{15mm}{4mm}

\titleformat{\subsection}
  {\bfseries\fontsize{14}{16}\selectfont}
  {\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{15mm}{4mm}

\titleformat{\subsubsection}
  {\bfseries\fontsize{12}{14}\selectfont}
  {\thesubsubsection}{1em}{}
\titlespacing*{\subsubsection}{0pt}{10pt}{4pt}

%%-------------------------------------
%% Header / footer
%%-------------------------------------
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% First page of chapter also with centered footer number, no header
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

%%-------------------------------------
%% Hyperlinks and references
%%-------------------------------------
\usepackage[hidelinks]{hyperref}
\usepackage[nameinlink]{cleveref}

\hypersetup{
    colorlinks=true,
    linkcolor=blue,
    filecolor=magenta,
    urlcolor=cyan,
    citecolor=blue,
    pdftitle={Dissertation Report}
}

%%-------------------------------------
%% Bibliography
%%-------------------------------------
\usepackage[numbers]{natbib}
\bibliographystyle{plainnat}
\usepackage[nottoc]{tocbibind}
\renewcommand{\bibname}{References}

%%-------------------------------------
%% Appendix
%%-------------------------------------
\usepackage[toc]{appendix}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% End of style file
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%