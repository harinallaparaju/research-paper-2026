<mxfile host="app.diagrams.net" modified="2026-04-06" agent="IBFV Paper" version="24.0.0" type="device">
  <diagram id="and-vs-ibfv" name="AND-Fusion vs IBFV">
    <mxGraphModel dx="960" dy="360" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== (a) CONVENTIONAL AND-FUSION ===== -->
        <mxCell id="and_title" value="&lt;b&gt;(a) Conventional AND-Fusion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;(Architectures A, B, C, D)&lt;/font&gt;" style="text;html=1;align=center;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="65" y="8" width="210" height="26" as="geometry"/>
