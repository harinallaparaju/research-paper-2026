          <mxGeometry x="140" y="88" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="and_fp" target="and_gate" parent="1">
