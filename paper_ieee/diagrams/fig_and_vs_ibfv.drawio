        <!-- NO: no-op -->
        <mxCell id="ibfv_noop" value="No change&lt;br&gt;&lt;font style=&quot;font-size:6px&quot;&gt;(zero penalty)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;strokeDasharray=4 4;" vertex="1" parent="1">
          <mxGeometry x="680" y="143" width="68" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="ie4" value="No" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;strokeDasharray=4 4;fontSize=7;" edge="1" source="ibfv_diamond" target="ibfv_noop" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- FP vault decode (always runs) -->
        <mxCell id="ibfv_decode" value="FP Vault&lt;br&gt;Decode&lt;br&gt;&lt;font style=&quot;font-size:6px&quot;&gt;Always runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="44" width="72" height="38" as="geometry"/>
