        </mxCell>
        <mxCell id="ae2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="and_iris" target="and_gate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Pass path -->
        <mxCell id="and_decode" value="FP Vault&lt;br&gt;Decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;" vertex="1" parent="1">
