        <!-- Result -->
        <mxCell id="ibfv_result" value="GAR&lt;sub&gt;IBFV&lt;/sub&gt; &#8805; GAR&lt;sub&gt;FP&lt;/sub&gt;  &lt;b&gt;Provably never worse&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#000000;fontSize=8;strokeWidth=2;" vertex="1" parent="1">
