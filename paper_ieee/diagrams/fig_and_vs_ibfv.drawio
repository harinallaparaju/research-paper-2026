        <!-- Blocked path -->
        <mxCell id="and_blocked" value="&lt;b&gt;Blocked&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:6px&quot;&gt;~46% of genuine users&lt;br&gt;rejected here&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#000000;fontSize=8;strokeWidth=2;" vertex="1" parent="1">
