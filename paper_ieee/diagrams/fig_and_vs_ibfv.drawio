        <!-- Result box -->
        <mxCell id="and_result" value="GAR&lt;sub&gt;AND&lt;/sub&gt; = GAR&lt;sub&gt;FP&lt;/sub&gt; &#215; GAR&lt;sub&gt;Iris&lt;/sub&gt; &lt;b&gt;&#8804; GAR&lt;sub&gt;FP&lt;/sub&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#000000;fontSize=8;strokeDasharray=4 4;" vertex="1" parent="1">
          <mxGeometry x="50" y="178" width="240" height="26" as="geometry"/>
        </mxCell>

        <!-- Problem list -->
