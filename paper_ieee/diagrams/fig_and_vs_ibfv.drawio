        <!-- Iris decision -->
        <mxCell id="ibfv_diamond" value="Key&lt;br&gt;recovered?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=7;" vertex="1" parent="1">
