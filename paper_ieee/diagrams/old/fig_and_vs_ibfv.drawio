<mxfile host="app.diagrams.net" modified="2026-04-06" agent="IBFV Paper" version="24.0.0" type="device">
  <diagram id="and-vs-ibfv" name="AND-Fusion vs IBFV Comparison">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== LEFT SIDE: AND-FUSION ==================== -->
        <mxCell id="and_title" value="&lt;b&gt;(a) Conventional AND-Fusion&lt;br&gt;(Architectures A, B, C, D)&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="280" height="40" as="geometry"/>
        </mxCell>

        <!-- AND: Fingerprint input -->
        <mxCell id="and_fp" value="Fingerprint&lt;br&gt;Query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="90" height="40" as="geometry"/>
        </mxCell>

        <!-- AND: Iris input -->
        <mxCell id="and_iris" value="Iris&lt;br&gt;Query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="90" height="40" as="geometry"/>
        </mxCell>

        <!-- AND: Iris Gate -->
        <mxCell id="and_gate" value="&lt;b&gt;IRIS GATE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Must pass FIRST&lt;br&gt;before FP matching&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="190" y="145" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- AND: FP Vault Decode -->
        <mxCell id="and_decode" value="FP Vault&lt;br&gt;Decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="80" width="90" height="40" as="geometry"/>
        </mxCell>

        <!-- AND: Arrows -->
        <mxCell id="and_a1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="and_fp" target="and_gate" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="150" y="100"/><mxPoint x="150" y="175"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="and_a2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="and_iris" target="and_gate" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- AND: Gate PASS -->
        <mxCell id="and_pass" value="Pass" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;fontSize=9;fontColor=#2E7D32;" edge="1" source="and_gate" target="and_decode" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="330" y="150"/><mxPoint x="330" y="100"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- AND: Gate BLOCK -->
        <mxCell id="and_blocked" value="&lt;b&gt;BLOCKED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;~46% of genuine&lt;br&gt;users rejected HERE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#b85450;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="170" width="130" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="and_block_arrow" value="Fail" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;fontSize=9;fontColor=#b85450;" edge="1" source="and_gate" target="and_blocked" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- AND: Result -->
        <mxCell id="and_result" value="&lt;b&gt;Result:&lt;/b&gt;&lt;br&gt;GAR_combined =&lt;br&gt;GAR_FP × GAR_Iris&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;≤ GAR_FP always&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="280" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- AND: Problem callout -->
        <mxCell id="and_problem" value="✗ EER &gt; Unimodal ALWAYS&lt;br&gt;✗ Iris failure = system failure&lt;br&gt;✗ Best B/C/D EER ≥ 23%&lt;br&gt;✗ Second modality HURTS" style="text;html=1;fontSize=10;fontColor=#b85450;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="360" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- ==================== DIVIDER ==================== -->
        <mxCell id="divider" value="" style="line;strokeWidth=2;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="30" width="1" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="vs_text" value="&lt;b&gt;VS&lt;/b&gt;" style="text;html=1;fontSize=18;fontColor=#666666;align=center;" vertex="1" parent="1">
          <mxGeometry x="530" y="190" width="40" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== RIGHT SIDE: IBFV ==================== -->
        <mxCell id="ibfv_title" value="&lt;b&gt;(b) IBFV: Iris-Boosted Fuzzy Vault&lt;br&gt;(Proposed Architecture)&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="700" y="20" width="300" height="40" as="geometry"/>
        </mxCell>

        <!-- IBFV: Fingerprint input -->
        <mxCell id="ibfv_fp" value="Fingerprint&lt;br&gt;Query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="90" height="40" as="geometry"/>
        </mxCell>

        <!-- IBFV: Iris input -->
        <mxCell id="ibfv_iris" value="Iris&lt;br&gt;Query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="200" width="90" height="40" as="geometry"/>
        </mxCell>

        <!-- IBFV: FP Vault Decode (always runs) -->
        <mxCell id="ibfv_decode" value="FP Vault&lt;br&gt;Decode&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;ALWAYS runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1565C0;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="75" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- IBFV: FP matching points -->
        <mxCell id="ibfv_fp_match" value="|X_FP|&lt;br&gt;FP points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565C0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="82" width="80" height="36" as="geometry"/>
        </mxCell>

        <!-- Arrow FP → match → decode -->
        <mxCell id="ibfv_a1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ibfv_fp" target="ibfv_fp_match" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ibfv_a1b" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ibfv_fp_match" target="ibfv_decode" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- IBFV: Iris attempt -->
        <mxCell id="ibfv_iris_try" value="Iris Key&lt;br&gt;Recovery&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;(attempt)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="195" width="90" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="ibfv_a2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ibfv_iris" target="ibfv_iris_try" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- IBFV: Success → Bonus -->
        <mxCell id="ibfv_bonus" value="&lt;b&gt;+K Bonus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Guaranteed genuine&lt;br&gt;polynomial points&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2E7D32;fontSize=10;fontColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="160" width="110" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="ibfv_success_arrow" value="54%" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=2;fontSize=9;fontColor=#2E7D32;" edge="1" source="ibfv_iris_try" target="ibfv_bonus" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- IBFV: Fail → No penalty -->
        <mxCell id="ibfv_nopenalty" value="No penalty&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Fall back to&lt;br&gt;FP-only decode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#E65100;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="907" y="225" width="95" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="ibfv_fail_arrow" value="46%" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E65100;fontSize=9;fontColor=#E65100;" edge="1" source="ibfv_iris_try" target="ibfv_nopenalty" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Arrow: bonus feeds into decode -->
        <mxCell id="ibfv_boost" value="+K" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=2;dashed=1;fontSize=9;fontColor=#2E7D32;" edge="1" source="ibfv_bonus" target="ibfv_decode" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="955" y="155"/><mxPoint x="955" y="130"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- IBFV: Result -->
        <mxCell id="ibfv_result" value="&lt;b&gt;Result:&lt;/b&gt;&lt;br&gt;GAR_IBFV ≥ GAR_Uni&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;≥ GAR_FP always&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2E7D32;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="290" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- IBFV: Benefits callout -->
        <mxCell id="ibfv_benefits" value="✓ EER ≤ Unimodal ALWAYS&lt;br&gt;✓ Iris failure = no penalty&lt;br&gt;✓ Up to 55% EER reduction&lt;br&gt;✓ Second modality HELPS" style="text;html=1;fontSize=10;fontColor=#2E7D32;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="360" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- ==================== BOTTOM COMPARISON ==================== -->
        <mxCell id="comparison_box" value="" style="rounded=1;strokeColor=#666666;fillColor=#fafafa;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="440" width="700" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="comparison_text" value="&lt;b&gt;Core Difference:&lt;/b&gt; AND-fusion &lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;GATES&lt;/b&gt;&lt;/font&gt; access (multiplicative penalty) while IBFV &lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;BOOSTS&lt;/b&gt;&lt;/font&gt; evidence (additive benefit).&lt;br&gt;Iris as a &lt;font color=&quot;#b85450&quot;&gt;mandatory gate&lt;/font&gt; vs. iris as an &lt;font color=&quot;#2E7D32&quot;&gt;optional booster&lt;/font&gt;." style="text;html=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="210" y="445" width="680" height="45" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
