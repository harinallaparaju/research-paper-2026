<mxfile host="app.diagrams.net" modified="2026-04-06" agent="IBFV Paper" version="24.0.0" type="device">
  <diagram id="threat-model" name="Threat Model - Attack Points">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="550" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Threat Model: Attack Points in IBFV Biometric System&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="400" height="25" as="geometry"/>
        </mxCell>

        <!-- ==================== SYSTEM COMPONENTS ==================== -->

        <!-- User / Sensor -->
        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;(Fingerprint&lt;br&gt;+ Iris)" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="100" height="55" as="geometry"/>
        </mxCell>

        <!-- Sensor -->
        <mxCell id="sensor" value="&lt;b&gt;Sensor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;FP Scanner&lt;br&gt;+ NIR Camera&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="90" height="55" as="geometry"/>
        </mxCell>

        <!-- Feature Extractor -->
        <mxCell id="extractor" value="&lt;b&gt;Feature&lt;br&gt;Extractor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Minutiae + Iris Code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="365" y="120" width="100" height="55" as="geometry"/>
        </mxCell>

        <!-- Vault Creator / Matcher -->
        <mxCell id="matcher" value="&lt;b&gt;IBFV Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Vault Create /&lt;br&gt;Vault Unlock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="120" width="100" height="55" as="geometry"/>
        </mxCell>

        <!-- Database -->
        <mxCell id="database" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;(V, S, h,&lt;br&gt;H(k), B)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="725" y="110" width="80" height="65" as="geometry"/>
        </mxCell>

        <!-- Decision Module -->
        <mxCell id="decision" value="&lt;b&gt;Decision&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Accept/Reject&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="120" width="90" height="55" as="geometry"/>
        </mxCell>

        <!-- Application -->
        <mxCell id="app" value="&lt;b&gt;Application&lt;/b&gt;" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2E7D32;fontSize=10;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="125" width="100" height="45" as="geometry"/>
        </mxCell>

        <!-- ==================== CONNECTING ARROWS ==================== -->
        <mxCell id="conn1" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="user" target="sensor" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="conn2" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="sensor" target="extractor" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="conn3" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="extractor" target="matcher" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="conn4" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="matcher" target="database" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="conn5" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="database" target="decision" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="conn6" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="decision" target="app" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ==================== ATTACK POINTS (Red circles with numbers) ==================== -->

        <!-- Attack 1: Spoofing -->
        <mxCell id="atk1" value="①" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="150" y="85" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="atk1_label" value="①&lt;b&gt; Spoofing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Fake biometric presented.&lt;br&gt;&lt;font color=&quot;#E65100&quot;&gt;Outside scope — requires&lt;br&gt;liveness detection.&lt;/font&gt;&lt;/font&gt;" style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="230" width="150" height="55" as="geometry"/>
        </mxCell>

        <!-- Attack 2: Sensor-to-Extractor channel -->
        <mxCell id="atk2" value="②" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="300" y="85" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="atk2_label" value="②&lt;b&gt; Channel Intercept&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Replay raw image.&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;Client-side; assumed secure.&lt;/font&gt;&lt;/font&gt;" style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="190" y="230" width="150" height="55" as="geometry"/>
        </mxCell>

        <!-- Attack 3: Feature Extractor Trojan -->
        <mxCell id="atk3" value="③" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="400" y="85" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="atk3_label" value="③&lt;b&gt; Trojan Horse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Compromised extractor.&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;Client-side; assumed secure.&lt;/font&gt;&lt;/font&gt;" style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="350" y="230" width="150" height="55" as="geometry"/>
        </mxCell>

        <!-- Attack 4: Extractor-to-Matcher channel -->
        <mxCell id="atk4" value="④" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="475" y="85" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="atk4_label" value="④&lt;b&gt; Feature Channel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Intercept features.&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;Local processing;&lt;br&gt;no transmission.&lt;/font&gt;&lt;/font&gt;" style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="500" y="230" width="140" height="55" as="geometry"/>
        </mxCell>

        <!-- Attack 5: Matcher attack (Hill-climbing) -->
        <mxCell id="atk5" value="⑤" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="575" y="85" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="atk5_label" value="⑤&lt;b&gt; Hill-Climbing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Iterative template refinement.&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;DEFENDED:&lt;/b&gt; Binary output&lt;br&gt;(no score feedback).&lt;/font&gt;&lt;/font&gt;" style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="310" width="180" height="55" as="geometry"/>
        </mxCell>

        <!-- Attack 6: Database breach (MAIN THREAT) -->
        <mxCell id="atk6" value="⑥" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;fontColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="750" y="82" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="atk6_label" value="⑥&lt;b&gt; Database Breach ★&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Attacker obtains (V, S, h, H(k), B).&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;DEFENDED:&lt;/b&gt; Fuzzy vault + ECC&lt;br&gt;+ ECDLP hardness. Brute-force&lt;br&gt;requires ~10¹² evaluations.&lt;/font&gt;&lt;/font&gt;" style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="230" y="310" width="200" height="65" as="geometry"/>
        </mxCell>

        <!-- Attack 7: Database-to-Matcher channel -->
        <mxCell id="atk7" value="⑦" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="820" y="85" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="atk7_label" value="⑦&lt;b&gt; Replay Vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Replay stored vault data.&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;Vault alone is useless&lt;br&gt;without live biometric.&lt;/font&gt;&lt;/font&gt;" style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="460" y="310" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- Attack 8: Decision override -->
        <mxCell id="atk8" value="⑧" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="980" y="85" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="atk8_label" value="⑧&lt;b&gt; Decision Override&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Flip Accept/Reject.&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;Mitigated by TLS/SSL&lt;br&gt;(system-level).&lt;/font&gt;&lt;/font&gt;" style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="650" y="310" width="150" height="55" as="geometry"/>
        </mxCell>

        <!-- Cross-matching attack -->
        <mxCell id="atk9_label" value="&lt;b&gt;Cross-Matching Attack:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Correlate vaults from different systems.&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;DEFENDED:&lt;/b&gt; Different (f, curve, G) per system → unlinkable templates.&lt;br&gt;D_sys ≤ 0.08 across all databases.&lt;/font&gt;&lt;/font&gt;" style="text;html=1;fontSize=9;align=left;rounded=1;strokeColor=#9673a6;fillColor=#f3e8ff;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="835" y="300" width="310" height="70" as="geometry"/>
        </mxCell>

        <!-- Client-side boundary -->
        <mxCell id="client_boundary" value="" style="rounded=1;strokeColor=#1565C0;fillColor=none;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="25" y="60" width="660" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="client_label" value="&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;Client Side (assumed secure)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="30" y="63" width="170" height="15" as="geometry"/>
        </mxCell>

        <!-- Server-side boundary -->
        <mxCell id="server_boundary" value="" style="rounded=1;strokeColor=#E65100;fillColor=none;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="695" y="60" width="150" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="server_label" value="&lt;font color=&quot;#E65100&quot;&gt;&lt;b&gt;Server (untrusted)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="700" y="63" width="120" height="15" as="geometry"/>
        </mxCell>
