<mxfile host="app.diagrams.net" modified="2026-04-06" agent="IBFV Paper" version="24.0.0" type="device">
  <diagram id="ibfv-enrollment" name="IBFV Enrollment Pipeline">
    <mxGraphModel dx="1400" dy="480" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== FINGERPRINT PATH (top row) ===== -->
        <mxCell id="fp_label" value="&lt;b&gt;Fingerprint Path&lt;/b&gt;" style="text;html=1;align=left;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="22" y="18" width="120" height="16" as="geometry"/>
        </mxCell>

        <mxCell id="fp_img" value="Fingerprint&lt;br&gt;Image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="25" y="40" width="80" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="fp_min" value="Minutiae&lt;br&gt;Extraction&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;&lt;i&gt;M&lt;/i&gt; = {(&lt;i&gt;x&lt;/i&gt;,&lt;i&gt;y&lt;/i&gt;,&lt;i&gt;&#952;&lt;/i&gt;)}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="140" y="36" width="95" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="fp_quant" value="Quantization&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;&#8970;&lt;i&gt;x&lt;/i&gt;/&lt;i&gt;f&lt;/i&gt;&#8971; &#8214; &#8970;&lt;i&gt;y&lt;/i&gt;/&lt;i&gt;f&lt;/i&gt;&#8971; &#8214; &#8970;&lt;i&gt;&#952;&lt;/i&gt;/&lt;i&gt;f&lt;/i&gt;&#8971;&lt;br&gt;&#8594; 18-bit integer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="270" y="34" width="110" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="fp_ec" value="EC Mapping&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;q&lt;/i&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt; &#183; &lt;i&gt;G&lt;/i&gt;&lt;br&gt;(BrainpoolP256r1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="415" y="34" width="110" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="fp_gen" value="&lt;b&gt;Genuine Points&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;G&lt;sub&gt;FP&lt;/sub&gt; = {(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;.&lt;i&gt;x&lt;/i&gt;, &lt;i&gt;p&lt;/i&gt;(&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;.&lt;i&gt;x&lt;/i&gt;))}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#000000;fontSize=9;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="36" width="135" height="46" as="geometry"/>
        </mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="fp_img" target="fp_min" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="fp_min" target="fp_quant" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="fp_quant" target="fp_ec" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="fp_ec" target="fp_gen" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== IRIS PATH (middle row) ===== -->
        <mxCell id="ir_label" value="&lt;b&gt;Iris Path&lt;/b&gt;" style="text;html=1;align=left;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="22" y="108" width="80" height="16" as="geometry"/>
        </mxCell>

        <mxCell id="ir_img" value="Iris&lt;br&gt;Image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#000000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="25" y="130" width="80" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="ir_extract" value="Iris Code&lt;br&gt;Extraction&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;Log-Gabor encoding&lt;br&gt;&lt;i&gt;c&lt;/i&gt; &#8712; {0,1}&lt;sup&gt;49152&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#000000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="140" y="124" width="110" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ir_commit" value="Fuzzy Commitment&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;Repetition code&lt;br&gt;Bit interleaving&lt;br&gt;&lt;i&gt;B&lt;/i&gt;&lt;sub&gt;&lt;i&gt;s&lt;/i&gt;&lt;/sub&gt; = 63 bits/block&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#000000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="285" y="122" width="115" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="ir_key" value="Key Hash&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;&#954; = SHA-256(&lt;i&gt;k&lt;/i&gt;)&lt;br&gt;&lt;i&gt;n&lt;/i&gt;&lt;sub&gt;&lt;i&gt;b&lt;/i&gt;&lt;/sub&gt; = 780-bit key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#000000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="435" y="126" width="100" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="ir_prf" value="PRF (SHA-256)&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt; = H(&quot;ibfv_vpt:&quot;&lt;br&gt;&#8214; &lt;i&gt;j&lt;/i&gt; &#8214; &quot;:&quot; &#8214; &#954;) mod &lt;i&gt;p&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#000000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="570" y="122" width="120" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="ir_bonus" value="&lt;b&gt;Bonus Points&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;G&lt;sub&gt;Iris&lt;/sub&gt; = {(&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;, &lt;i&gt;p&lt;/i&gt;(&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;))}&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;=0&lt;/sub&gt;&lt;sup&gt;&lt;i&gt;K&lt;/i&gt;&#8722;1&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#000000;fontSize=9;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="725" y="126" width="135" height="46" as="geometry"/>
        </mxCell>

        <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="ir_img" target="ir_extract" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="ir_extract" target="ir_commit" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="ir_commit" target="ir_key" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="ir_key" target="ir_prf" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="ir_prf" target="ir_bonus" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== POLYNOMIAL (feeds both paths) ===== -->
        <mxCell id="poly" value="Random Polynomial&lt;br&gt;&lt;i&gt;p&lt;/i&gt;(&lt;i&gt;x&lt;/i&gt;) of degree &lt;i&gt;k&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="415" y="210" width="135" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p2g" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;strokeDasharray=4 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" source="poly" target="fp_gen" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="483" y="195"/><mxPoint x="628" y="195"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2b" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;strokeDasharray=4 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="poly" target="ir_bonus" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="700" y="228"/><mxPoint x="700" y="149"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== MERGE AND VAULT ===== -->
        <mxCell id="chaff_gen" value="Chaff Generation&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;5&lt;i&gt;g&lt;/i&gt; random points&lt;br&gt;not on &lt;i&gt;p&lt;/i&gt;(&lt;i&gt;x&lt;/i&gt;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;strokeDasharray=4 4;" vertex="1" parent="1">
          <mxGeometry x="900" y="210" width="115" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="merge" value="Shuffle &amp;amp; Merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#000000;fontSize=9;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="105" width="115" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="vault_out" value="&lt;b&gt;Stored Vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;(&lt;i&gt;V&lt;/i&gt;, &lt;i&gt;S&lt;/i&gt;, &lt;b&gt;h&lt;/b&gt;, &lt;i&gt;H&lt;/i&gt;(&lt;b&gt;k&lt;/b&gt;), &lt;i&gt;B&lt;/i&gt;&lt;sub&gt;&lt;i&gt;s&lt;/i&gt;&lt;/sub&gt;)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#E0E0E0;strokeColor=#000000;fontSize=9;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1065" y="92" width="110" height="58" as="geometry"/>
        </mxCell>

        <mxCell id="m1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="fp_gen" target="merge" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="59"/><mxPoint x="870" y="121"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="m2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;" edge="1" source="ir_bonus" target="merge" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="149"/><mxPoint x="870" y="121"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="m3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;strokeDasharray=4 4;" edge="1" source="chaff_gen" target="merge" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="958" y="210"/><mxPoint x="958" y="137"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="m4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;strokeWidth=2;" edge="1" source="merge" target="vault_out" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Helper data output from iris commitment -->
        <mxCell id="helper" value="&lt;font style=&quot;font-size:7px&quot;&gt;Helper data&lt;br&gt;(&lt;b&gt;h&lt;/b&gt;, &lt;i&gt;H&lt;/i&gt;(&lt;b&gt;k&lt;/b&gt;))&lt;/font&gt;" style="text;html=1;fontSize=7;fontColor=#555555;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="75" height="25" as="geometry"/>
        </mxCell>

        <!-- Separator lines for paths -->
        <mxCell id="sep1" value="" style="line;strokeWidth=1;strokeColor=#CCCCCC;strokeDasharray=2 2;" vertex="1" parent="1">
          <mxGeometry x="20" y="98" width="860" height="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
