# ─── D-IBFV Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is never committed to git.

# ── IPFS ─────────────────────────────────────────────────────────────────────
# Default: local IPFS daemon started by Docker Compose.
# Change only if you run IPFS separately.
IPFS_API_URL=http://127.0.0.1:5001

# ── Ganache (local Ethereum) ──────────────────────────────────────────────────
# Default: Ganache started by Docker Compose on port 8545.
GANACHE_RPC=http://127.0.0.1:8545

# ── Public testnets (optional — leave blank if not using) ─────────────────────
# Get a free key from https://infura.io or https://alchemy.com
SEPOLIA_RPC=https://rpc.sepolia.org
AMOY_RPC=https://rpc-amoy.polygon.technology

# Private key for testnet transactions (no real ETH needed — testnet only).
# NEVER use a wallet that holds real funds.
# Example: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
TESTNET_PRIVATE_KEY=

# ── Hyperledger Fabric (optional) ────────────────────────────────────────────
# Only needed for Fabric experiments. See README section 5.
FABRIC_GATEWAY_URL=http://127.0.0.1:7054
