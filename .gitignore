# ─────────────────────────────────────────────────────────────────────────────
# D-IBFV .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Biometric data (large — share separately, never commit) ──────────────────
data/Iris/CASIA-Iris-Interval/
data/Iris/iris_codes/
data/Iris/iris_codes_old_v1/
data/minutiae/

# ── Generated experiment results (regenerate by running the scripts) ─────────
code/results/
code/dibfv/results/

# ── Secrets — NEVER commit ───────────────────────────────────────────────────
.env
code/dibfv/.env

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── macOS system files ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE / editor files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Compiled LaTeX output ─────────────────────────────────────────────────────
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls

# ── Jupyter notebook checkpoints ─────────────────────────────────────────────
.ipynb_checkpoints/

# ── Build artifacts ───────────────────────────────────────────────────────────
*.egg-info/
dist/
build/
